# Copia este archivo a .env y reemplaza el placeholder por tu clave.
# No subas .env ni escribas secretos en esta plantilla.
LLM_API_KEY=replace_with_your_api_key
LLM_BASE_URL=https://llm.4geeks.ai
LLM_MODEL=online/openrouter/openai/gpt-6-luna

# Opcional: URL de la API de inventario. Por defecto usa localhost:8000.
INVENTORY_API_URL=http://127.0.0.1:8000
